<style>
    * { box-sizing: border-box; }
    body { font-family: "Segoe UI", Arial, sans-serif; color: #222; background: #f2f2f2; margin: 0; padding: 24px; }
    .sheet { max-width: 800px; margin: 0 auto; background: #fff; padding: 36px 40px; box-shadow: 0 2px 10px rgba(0,0,0,.12); }
    .head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #111; padding-bottom: 14px; margin-bottom: 18px; }
    .brand { font-size: 28px; font-weight: 800; letter-spacing: 2px; }
    .brand small { display: block; font-size: 12px; font-weight: 400; letter-spacing: 0; color: #666; }
    .title { text-align: right; }
    .title h1 { margin: 0; font-size: 22px; }
    .title div { font-size: 13px; color: #555; margin-top: 4px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 18px; }
    .box { border: 1px solid #ddd; border-radius: 6px; padding: 12px 14px; font-size: 14px; line-height: 1.6; }
    .box h3 { margin: 0 0 6px; font-size: 13px; text-transform: uppercase; color: #777; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 14px; }
    th, td { border: 1px solid #ddd; padding: 8px 10px; text-align: left; }
    th { background: #f6f6f6; }
    .r { text-align: right; }
    .c { text-align: center; }
    .totals { width: 55%; margin-left: auto; }
    .totals td { border: none; border-bottom: 1px dashed #ddd; }
    .totals .grand td { border-top: 2px solid #111; border-bottom: none; font-weight: 700; font-size: 16px; }
    .timeline { list-style: none; padding: 0; margin: 0 0 14px; font-size: 14px; }
    .timeline li { padding: 6px 0 6px 22px; position: relative; border-left: 2px solid #ddd; margin-left: 6px; }
    .timeline li::before { content: ""; position: absolute; left: -7px; top: 11px; width: 12px; height: 12px; border-radius: 50%; background: #ccc; }
    .timeline li.done::before { background: #2e7d32; }
    .timeline li.done { color: #111; }
    .timeline li:not(.done) { color: #999; }
    .barcode { font-family: "Libre Barcode 39", monospace; letter-spacing: 3px; font-size: 22px; border: 2px dashed #111; padding: 8px 14px; display: inline-block; font-weight: 700; }
    .sign { display: grid; grid-template-columns: 1fr 1fr; text-align: center; margin-top: 30px; font-size: 14px; }
    .sign div { height: 90px; }
    .foot { text-align: center; font-size: 12px; color: #777; margin-top: 18px; border-top: 1px solid #eee; padding-top: 10px; }
    .toolbar { max-width: 800px; margin: 0 auto 14px; display: flex; gap: 10px; }
    .toolbar a, .toolbar button { font: inherit; padding: 8px 16px; border-radius: 6px; border: 1px solid #111; background: #fff; color: #111; cursor: pointer; text-decoration: none; }
    .toolbar .primary { background: #111; color: #fff; }
    @media print {
        body { background: #fff; padding: 0; }
        .sheet { box-shadow: none; padding: 0; max-width: none; }
        .toolbar { display: none; }
    }
</style>

